[Unit]
Description=onlydeals ingest (n8n → feed bridge)
Documentation=https://alinma.example/internal/onlydeals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onlydeals
Group=onlydeals
ExecStart=/usr/bin/node /opt/onlydeals/ingest.mjs

# config — the API key lives in /etc/onlydeals/ingest.env (chmod 600)
Environment=PORT=8787
Environment=FEED_FILE=/var/lib/onlydeals/onlydeals.json
EnvironmentFile=/etc/onlydeals/ingest.env

Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/onlydeals

[Install]
WantedBy=multi-user.target

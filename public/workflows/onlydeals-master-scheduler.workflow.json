{
  "name": "OnlyDeals · Master Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "triggerAtHour": 6 }, { "triggerAtHour": 12 }, { "triggerAtHour": 18 }]
        }
      },
      "id": "ms-01-schedule",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// PLUG-AND-PLAY SOURCE REGISTRY\n// Adding a source = deploy its workflow (webhook onlydeals-<id>) + add ONE line here.\nconst base = ($env.ONLYDEALS_N8N_BASE || \"https://n8n.example.com\").replace(/\\/+$/, \"\");\nconst sources = [\n  { id: \"alrajhi\", name: \"Al Rajhi Bank\", trigger: base + \"/webhook/onlydeals-alrajhi\" },\n  { id: \"jarir\",   name: \"Jarir\",         trigger: base + \"/webhook/onlydeals-jarir\" }\n];\nreturn sources.map(s => ({ json: s }));"
      },
      "id": "ms-02-registry",
      "name": "Source registry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.trigger }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"triggeredFrom\":\"master-scheduler\",\"at\":\"{{ $now.toISO() }}\"}",
        "options": {
          "timeout": 45000,
          "batching": { "batch": { "batchSize": 1, "batchInterval": 500 } }
        }
      },
      "id": "ms-03-fanout",
      "name": "Trigger each source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst report = items.map(it => ({\n  id: it.json.id ?? \"unknown\",\n  name: it.json.name ?? \"unknown\",\n  ok: !it.json.error,\n  statusCode: it.json.statusCode ?? null,\n  body: it.json.body ?? null,\n  error: it.json.error ?? null\n}));\nconst live = report.filter(r => r.ok).length;\nreturn [{ json: {\n  generator: \"n8n:master-scheduler\",\n  ranAt: new Date().toISOString(),\n  live,\n  total: report.length,\n  report\n} }];"
      },
      "id": "ms-04-aggregate",
      "name": "Aggregate report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn r.report.map(x => ({ json: {\n  timestamp: r.ranAt,\n  source: 'scheduler\\u2192' + x.id,\n  offers: (x.body && x.body.offers) || 0,\n  status: x.ok ? 'live' : 'error',\n  generator: r.generator\n} }));"
      },
      "id": "ms-10-rows",
      "name": "Scheduler rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "PASTE_SPREADSHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "runs", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [] },
        "options": {}
      },
      "id": "ms-11-sheets",
      "name": "Log runs to sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1340, 300],
      "continueOnFail": true,
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_AFTER_IMPORT", "name": "onlydeals-sheets-sa" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ONLYDEALS_STATUS_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{ $env.ONLYDEALS_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Aggregate report').first().json) }}",
        "options": { "timeout": 15000 }
      },
      "id": "ms-05-status",
      "name": "Post run report (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every 6 hours": { "main": [[{ "node": "Source registry", "type": "main", "index": 0 }]] },
    "Source registry": { "main": [[{ "node": "Trigger each source", "type": "main", "index": 0 }]] },
    "Trigger each source": { "main": [[{ "node": "Aggregate report", "type": "main", "index": 0 }]] },
    "Aggregate report": { "main": [[{ "node": "Scheduler rows", "type": "main", "index": 0 }]] },
    "Scheduler rows": { "main": [[{ "node": "Log runs to sheet", "type": "main", "index": 0 }]] },
    "Log runs to sheet": { "main": [[{ "node": "Post run report (optional)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
